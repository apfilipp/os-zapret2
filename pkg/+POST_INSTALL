#!/bin/sh

# Post-install hook for os-zapret2.
# Runs after pkg has laid down the files. Reloads configd actions and clears
# the GUI ACL/menu cache so the new Services > Zapret menu entry shows up
# without a manual webgui reload.

# configd consists of a persistent supervisor and a worker that handles the
# socket and loads actions.d. Restarting the whole service synchronously from
# a pkg hook can leave configd stopped when the package transaction tears down
# its descendants. Terminating only the existing worker makes the pre-existing
# supervisor reload it safely with the newly installed action definitions.
reload_configd_actions()
{
    zapret_configd_pidfile=/var/run/configd.pid
    zapret_configd_socket=/var/run/configd.socket

    # Do not start a previously stopped system service from a package hook.
    # Its actions will be loaded the next time OPNsense starts configd.
    if [ ! -r "${zapret_configd_pidfile}" ]; then
        echo "NOTICE: configd is not running; live Zapret action reload skipped" >&2
        return 0
    fi

    zapret_configd_supervisor=$(cat "${zapret_configd_pidfile}" 2>/dev/null)
    case "${zapret_configd_supervisor}" in
        ''|*[!0-9]*)
            echo "WARNING: invalid configd pidfile; live Zapret action reload skipped" >&2
            return 1
            ;;
    esac

    if ! kill -0 "${zapret_configd_supervisor}" 2>/dev/null ||
        ! /bin/ps -p "${zapret_configd_supervisor}" -o command= 2>/dev/null |
            /usr/bin/grep -Fq '/usr/local/opnsense/service/configd.py'; then
        echo "WARNING: configd supervisor is unavailable; live Zapret action reload skipped" >&2
        return 1
    fi

    zapret_configd_worker=$(/usr/bin/pgrep -P "${zapret_configd_supervisor}" | /usr/bin/head -1)
    if [ -z "${zapret_configd_worker}" ] || ! kill -TERM "${zapret_configd_worker}" 2>/dev/null; then
        echo "WARNING: configd worker could not be reloaded" >&2
        return 1
    fi

    zapret_configd_wait=0
    while [ "${zapret_configd_wait}" -lt 50 ]; do
        zapret_configd_new_worker=$(/usr/bin/pgrep -P "${zapret_configd_supervisor}" |
            /usr/bin/head -1)
        if [ -n "${zapret_configd_new_worker}" ] &&
            [ "${zapret_configd_new_worker}" != "${zapret_configd_worker}" ] &&
            [ -S "${zapret_configd_socket}" ] &&
            /usr/local/sbin/configctl -q configd lookup 'zapret status' >/dev/null 2>&1; then
            return 0
        fi
        /bin/sleep 0.1
        zapret_configd_wait=$((zapret_configd_wait + 1))
    done

    echo "WARNING: timed out waiting for configd worker reload" >&2
    return 1
}

reload_configd_actions || true

# Run MVC model migrations using the standard OPNsense plugin lifecycle.
if [ -f /usr/local/opnsense/mvc/script/run_migrations.php ]; then
    /usr/local/opnsense/mvc/script/run_migrations.php OPNsense/Zapret
fi

# Reload plugin configuration and flush user-facing caches.
if [ -f /usr/local/etc/rc.configure_plugins ]; then
    /usr/local/etc/rc.configure_plugins POST_INSTALL
fi

# Render the initial config template (no-op if settings haven't been saved yet)
if [ -x /usr/local/sbin/configctl ]; then
    /usr/local/sbin/configctl template reload OPNsense/Zapret >/dev/null 2>&1 || true
fi

cat <<'NEXT_STEPS'

================================================================
os-zapret2 installed. Next steps before first use:

  1. Bootstrap dependencies and compile dvtws2 (one-time, ~1 min):

       /usr/local/opnsense/scripts/OPNsense/Zapret/setup.sh

     This installs luajit, jq, git-lite or git, pkgconf from FreeBSD's pkg
     repo and clones+compiles bol-van/zapret2.

  2. In the GUI: Services > Zapret DPI Bypass > Settings
       - Enable the service
       - Pick your WAN interface
       - Paste your DPI strategies (or use Diagnostics > Blockcheck
         to find ones that work for your ISP)
       - Save & Apply

The service auto-starts on every reboot once Enable is checked.
================================================================

NEXT_STEPS

exit 0
